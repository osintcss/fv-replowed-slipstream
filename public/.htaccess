<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/x-shockwave-flash
    AddOutputFilterByType DEFLATE application/x-amf
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType application/x-shockwave-flash "access plus 1 year"
    ExpiresByType application/octet-stream "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpg|jpeg|gif|swf|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Legacy Pepper Flash rejects some SWF responses when the global
    # nosniff policy is present. Keep nosniff for every other resource.
    <FilesMatch "\.swf$">
        Header always unset X-Content-Type-Options
    </FilesMatch>
</IfModule>

# Cache all static files in the assets directory (including octet-stream)
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/farmville/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # The bundled AMFphp test harness, examples, and documentation are not
    # part of the production application. Keep their PHP entry points out of
    # the public web root so they cannot be used as test gateways or write
    # targets by an external request.
    RewriteRule ^farmville/flashservices/(?:Tests|Examples|doc|docs)(?:/|$) - [R=404,L,NC]

    # A distinct filename gives the legacy Flash preloader and browser cache a
    # real client-build revision while serving the tracked patched SWF.
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-fuelrefill1\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-farmactiondispatch2\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-coveemptyworld1\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-floatingskullmask1\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-gopherprogressguard3\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-worldscorepersist1\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-worldscorepersist2\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-witcherhut1\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-turbocombinefree1\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-marketbyworld2\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-marketsearchworld1\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-lonelyanimalguard1\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-worldscorecoalesce1\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]
    RewriteRule ^farmville/embeds/Flash/v855037\.855026/FarmGame-10-emeraldscore1\.swf$ farmville/embeds/Flash/v855037.855026/FarmGame-10.swf [L]

    RewriteRule ^farmville/xml/gz/v855038-locale-v3/en_US\.swf$ farmville/locale-contract.php [L]

    # The recovered optimized asset is the same content-hashed Cove
    # background requested by some client variants. Keep the ordinary logical
    # path working when the extraction contains only the optimized directory.
    RewriteCond %{DOCUMENT_ROOT}/farmville/assets/hashed/assets/opt/Environment/7ed449f2a87c572e9ff8b144b15e0b09.swf -f
    RewriteRule ^farmville/assets/hashed/assets/Environment/7ed449f2a87c572e9ff8b144b15e0b09\.swf$ farmville/assets/hashed/assets/opt/Environment/7ed449f2a87c572e9ff8b144b15e0b09.swf [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
